# Desarrollo local sin AWS
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
AUTH_MODE=dev
STORE_MODE=memory
LLM_MODE=fake
SESSION_SECRET=cambia-esto-por-un-secreto-largo
DAILY_QUOTA_USD=10
RETENTION_DAYS=30
# Producción (los secretos llegan desde Secrets Manager, no desde este archivo)
# AUTH_MODE=cognito STORE_MODE=dynamo LLM_MODE=bedrock AWS_REGION=us-east-1
# COGNITO_REGION= COGNITO_USER_POOL_ID= COGNITO_CLIENT_ID= COGNITO_DOMAIN=https://xxx.auth.us-east-1.amazoncognito.com
# TABLE_CONVERSATIONS= TABLE_MESSAGES= TABLE_SESSIONS= TABLE_AUDIT= TABLE_USAGE=
# Alternativas a Bedrock para los modelos (la app es la misma; cambia solo el proveedor):
# LLM_MODE=anthropic ANTHROPIC_API_KEY=<secreto>            # Claude API de Anthropic (Sonnet 5 / Opus 5 / Fable 5.1). PHI solo con BAA de Anthropic.
# LLM_MODE=claude-platform-aws AWS_REGION=us-east-1 ANTHROPIC_AWS_WORKSPACE_ID=<id>   # Claude Platform on AWS (operado por Anthropic).
