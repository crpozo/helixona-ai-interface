{
  "app": "npx tsx bin/app.ts",
  "watch": {
    "include": ["bin/**", "lib/**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "node_modules", "test"]
  },
  "context": {
    "stage": "prod",
    "appBaseUrl": "https://chat.example-clinic.test",
    "domainName": "",
    "certificateArn": "",
    "cloudFrontCertificateArn": "",
    "cognitoDomainPrefix": "helixona-clinica",
    "enableNat": false,
    "tlsToContainer": false,
    "imageTag": "latest",
    "desiredCount": 1,
    "alertEmail": "",
    "monthlyBudgetUsd": 1500,
    "enableCloudTrail": false,
    "enableConfig": false,
    "hipaaConformancePackS3Uri": "",
    "retentionDays": 30,
    "geoAllowCountries": "",
    "cloudFrontPrefixListId": "",
    "availabilityZones": "",
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ecs:removeDefaultDeploymentAlarm": true,
    "@aws-cdk/aws-ecs:enableImdsBlockingDeprecatedFeature": false,
    "@aws-cdk/aws-elasticloadbalancingv2:albDualstackWithoutPublicIpv4SecurityGroupRulesDefault": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-kms:reduceCrossAccountRegionPolicyScope": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true
  }
}
